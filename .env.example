# Copy to .env.local and replace every value. Never commit .env.local.
# Leave these placeholders to open the app without Firebase. Blackline stays
# in the "add your Firebase config" state instead of calling a model.
# Do not put an App Check debug token in this file.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Public reCAPTCHA Enterprise site key (a score-based web key from Google
# Cloud Fraud Defense) used by App Check outside localhost.
# On localhost the app sets self.FIREBASE_APPCHECK_DEBUG_TOKEN = true
# and prints a debug token in the browser console. Register that token
# in Firebase. Never commit the token.
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
